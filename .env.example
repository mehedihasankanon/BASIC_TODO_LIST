# ---------------------------------------------------------------------------
# Sample environment file for the PERN Todo List (Supabase API backend)
#
# Copy this file to .env and fill in the real values:
#     cp .env.example .env        (macOS / Linux)
#     copy .env.example .env      (Windows)
#
# .env is git-ignored, so your real keys never get committed.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key: server-only, bypasses Row Level Security.
# NEVER put this key in the React client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional fallback. Only used when SUPABASE_SERVICE_ROLE_KEY is empty.
# Note: the anon key is subject to RLS policies.
SUPABASE_ANON_KEY=your-anon-key

# --- Server -----------------------------------------------------------------
PORT=4500

# --- JWT --------------------------------------------------------------------
# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRATION_TIME=6h

# --- Passwords --------------------------------------------------------------
BCRYPT_SALT_ROUNDS=10

# --- React client (create-react-app reads variables prefixed with REACT_APP_) -
REACT_APP_API_URL=http://localhost:4500
